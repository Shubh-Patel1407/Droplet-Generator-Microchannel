FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Flexible microchannel material properties (silicone rubber)
// Selected for tunable deformation under moderate pressure loading

rho
{
    type        uniform;
    value       950;  // Silicone rubber density (kg/m³)
}

nu
{
    type        uniform;
    value       0.48;  // Poisson ratio - nearly incompressible rubber (0.48-0.50)
}

E
{
    type        uniform;
    value       2.5e6;  // Young's modulus 2.5 MPa (soft silicone rubber)
                        // Typical rubber: 0.5-10 MPa depending on durometer
                        // This provides significant deformation under 1500 Pa
}

Cv
{
    type        uniform;
    value       1300;  // Specific heat capacity (J/kg·K)
}

kappa
{
    type        uniform;
    value       0.15;  // Thermal conductivity (W/m·K) - silicone rubber
}

alphav
{
    type        uniform;
    value       1.5e-4;  // Thermal expansion coefficient (1/K) - silicone

planeStress     no;
thermalStress   no;

