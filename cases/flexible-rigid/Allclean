#!/bin/bash
set -e
cd "${0%/*}"

if [ -z "${WM_PROJECT_DIR:-}" ] && [ -f /opt/openfoam13/etc/bashrc ]; then
    . /opt/openfoam13/etc/bashrc
fi

set -u

for case_name in rigid flexible; do
    foamListTimes -case "$case_name" -rm >/dev/null 2>&1 || true
    rm -rf "$case_name/constant/polyMesh" "$case_name/postProcessing"
    rm -f "$case_name"/log.*
done
rm -f validation_results.csv
